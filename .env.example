# Copy to .env.local for local use. In Vercel, configure Production variables and redeploy.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Alternative matching pair: GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# Scan as a guest only after choosing Continue as Guest on the landing-page dialog.
# Private account tools and saved reports require authentication.
# Required for private account/guest history and website-wide statistics.
# For an empty database, apply prisma/persistent-history.sql once; see docs/persistent-history-setup.md.
DATABASE_URL=
# Optional detection providers:
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
HUGGINGFACE_API_KEY=
SERP_API_KEY=
# Optional legacy email-verification delivery (not required for Google sign-in):
RESEND_API_KEY=
EMAIL_FROM=
