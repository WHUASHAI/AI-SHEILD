/* ── RESET & BASE ─────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:         #050510;
  --bg-2:       #080818;
  --surface:    rgba(255,255,255,0.04);
  --surface-2:  rgba(255,255,255,0.07);
  --border:     rgba(255,255,255,0.08);
  --border-2:   rgba(255,255,255,0.14);
  --purple:     #8b5cf6;
  --cyan:       #06b6d4;
  --pink:       #ec4899;
  --green:      #10b981;
  --yellow:     #f59e0b;
  --red:        #ef4444;
  --text:       #f1f5f9;
  --text-2:     #94a3b8;
  --text-3:     #64748b;
  --radius:     16px;
  --radius-sm:  10px;
  --radius-xs:  6px;
  --shadow:     0 8px 40px rgba(0,0,0,0.5);
  --glow-purple: 0 0 40px rgba(139,92,246,0.3);
  --glow-cyan:   0 0 40px rgba(6,182,212,0.3);
}

html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

body {
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
  position: relative;
}

/* ── BACKGROUND CANVAS ────────────────────────────── */
#bg-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.35;
}

/* ── ORBS ─────────────────────────────────────────── */
.orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: 0;
  animation: orbFloat 20s ease-in-out infinite;
}
.orb-1 { width: 500px; height: 500px; background: rgba(139,92,246,0.12); top: -100px; right: -100px; animation-delay: 0s; }
.orb-2 { width: 600px; height: 600px; background: rgba(6,182,212,0.08); bottom: 20%; left: -150px; animation-delay: -7s; }
.orb-3 { width: 400px; height: 400px; background: rgba(236,72,153,0.07); top: 40%; right: 10%; animation-delay: -14s; }

@keyframes orbFloat {
  0%,100% { transform: translate(0,0) scale(1); }
  33%      { transform: translate(30px,-40px) scale(1.05); }
  66%      { transform: translate(-20px,30px) scale(0.97); }
}

/* ── SCROLLBAR ────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg-2); }
::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.4); border-radius: 3px; }

/* ── UTILITY ──────────────────────────────────────── */
.container { max-width: 1140px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }

.gradient-text {
  background: linear-gradient(135deg, var(--purple), var(--cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.spin { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ── NAVIGATION ───────────────────────────────────── */
#navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  backdrop-filter: blur(20px) saturate(180%);
  background: rgba(5,5,16,0.7);
  border-bottom: 1px solid var(--border);
  transition: background 0.3s;
}
#navbar.scrolled { background: rgba(5,5,16,0.95); }

.nav-inner {
  max-width: 1140px; margin: 0 auto; padding: 0 24px;
  height: 68px; display: flex; align-items: center; gap: 32px;
}

.nav-logo {
  display: flex; align-items: center; gap: 10px;
  text-decoration: none; flex-shrink: 0;
}
.logo-icon {
  width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
  background: rgba(139,92,246,0.15); border-radius: 10px;
  border: 1px solid rgba(139,92,246,0.25);
}
.logo-text { font-size: 1.15rem; font-weight: 800; color: var(--text); letter-spacing: -0.02em; }
.logo-accent { color: var(--purple); }

.nav-links {
  display: flex; list-style: none; gap: 4px; flex: 1; justify-content: center;
}
.nav-link {
  color: var(--text-2); text-decoration: none; font-size: 0.9rem; font-weight: 500;
  padding: 8px 14px; border-radius: var(--radius-xs);
  transition: color 0.2s, background 0.2s;
}
.nav-link:hover { color: var(--text); background: var(--surface); }

.nav-cta { flex-shrink: 0; }

/* Buttons */
.btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  background: linear-gradient(135deg, var(--purple), var(--cyan));
  color: #fff; font-weight: 600; font-size: 0.9rem;
  padding: 10px 20px; border-radius: var(--radius-sm);
  text-decoration: none; border: none; cursor: pointer;
  transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 4px 20px rgba(139,92,246,0.4);
}
.btn-primary:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 6px 28px rgba(139,92,246,0.5); }
.btn-primary:active { transform: translateY(0); }

.btn-primary.btn-lg { padding: 14px 28px; font-size: 1rem; border-radius: var(--radius); }

.btn-ghost {
  display: inline-flex; align-items: center; gap: 8px;
  background: transparent; color: var(--text-2); font-weight: 500; font-size: 0.9rem;
  padding: 10px 20px; border-radius: var(--radius-sm);
  text-decoration: none; border: 1px solid var(--border-2); cursor: pointer;
  transition: color 0.2s, border-color 0.2s, background 0.2s;
}
.btn-ghost:hover { color: var(--text); border-color: var(--purple); background: rgba(139,92,246,0.08); }
.btn-ghost.btn-lg { padding: 14px 28px; font-size: 1rem; border-radius: var(--radius); }

.btn-ghost-sm {
  display: inline-flex; align-items: center; gap: 6px;
  background: transparent; color: var(--text-3); font-size: 0.8rem; font-weight: 500;
  padding: 6px 12px; border-radius: var(--radius-xs);
  border: 1px solid var(--border); cursor: pointer;
  transition: color 0.2s, border-color 0.2s, background 0.2s;
}
.btn-ghost-sm:hover { color: var(--text); border-color: var(--border-2); background: var(--surface); }

/* Hamburger */
.hamburger {
  display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer;
  padding: 8px;
}
.hamburger span { display: block; width: 22px; height: 2px; background: var(--text-2); border-radius: 2px; transition: 0.3s; }

.mobile-menu {
  display: none; flex-direction: column; padding: 12px 24px 20px;
  border-top: 1px solid var(--border);
  background: rgba(5,5,16,0.95); backdrop-filter: blur(20px);
}
.mobile-menu.open { display: flex; }
.mob-link { color: var(--text-2); text-decoration: none; padding: 12px 0; font-weight: 500; border-bottom: 1px solid var(--border); }
.mob-link:last-child { border-bottom: none; }

/* ── HERO ─────────────────────────────────────────── */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; padding: 120px 24px 80px;
  position: relative; z-index: 1;
}
.hero-inner { max-width: 800px; }

.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.25);
  color: var(--purple); font-size: 0.8rem; font-weight: 600;
  padding: 6px 16px; border-radius: 99px; margin-bottom: 28px;
  letter-spacing: 0.05em; text-transform: uppercase;
}
.badge-dot {
  width: 7px; height: 7px; border-radius: 50%; background: var(--green);
  box-shadow: 0 0 8px var(--green);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.85); }
}

.hero-title {
  font-size: clamp(2.6rem, 7vw, 5rem); font-weight: 900;
  line-height: 1.08; letter-spacing: -0.04em; margin-bottom: 24px;
  animation: fadeUp 0.7s ease both;
}
.hero-subtitle {
  font-size: clamp(1rem, 2.5vw, 1.2rem); color: var(--text-2); line-height: 1.7;
  margin-bottom: 40px; max-width: 600px; margin-left: auto; margin-right: auto;
  animation: fadeUp 0.7s 0.1s ease both;
}

.hero-actions {
  display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;
  margin-bottom: 56px;
  animation: fadeUp 0.7s 0.2s ease both;
}

.hero-stats {
  display: flex; align-items: center; justify-content: center;
  gap: 24px; flex-wrap: wrap;
  padding: 20px 32px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); backdrop-filter: blur(10px);
  margin-bottom: 28px;
  animation: fadeUp 0.7s 0.3s ease both;
}
.hstat { text-align: center; }
.hstat-num { display: block; font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; background: linear-gradient(135deg, var(--purple), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.hstat-lbl { font-size: 0.75rem; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; }
.hstat-divider { width: 1px; height: 36px; background: var(--border-2); }

.hero-modality-pills {
  display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;
  animation: fadeUp 0.7s 0.4s ease both;
}
.mpill {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 16px; border-radius: 99px; font-size: 0.8rem; font-weight: 600;
  border: 1px solid;
}
.mpill-text  { background: rgba(139,92,246,0.1); border-color: rgba(139,92,246,0.3); color: var(--purple); }
.mpill-image { background: rgba(6,182,212,0.1);  border-color: rgba(6,182,212,0.3);  color: var(--cyan);   }
.mpill-code  { background: rgba(236,72,153,0.1); border-color: rgba(236,72,153,0.3); color: var(--pink);   }

.hero-scroll-indicator {
  position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  color: var(--text-3); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
}
.scroll-mouse {
  width: 24px; height: 36px; border: 2px solid var(--border-2); border-radius: 99px;
  display: flex; justify-content: center; padding-top: 6px;
}
.scroll-wheel {
  width: 4px; height: 8px; background: var(--purple); border-radius: 2px;
  animation: scrollWheel 2s ease-in-out infinite;
}
@keyframes scrollWheel {
  0%,100% { transform: translateY(0); opacity: 1; }
  50%      { transform: translateY(8px); opacity: 0.3; }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── SECTIONS ─────────────────────────────────────── */
.section { padding: 100px 0; position: relative; z-index: 1; }

.section-header { text-align: center; margin-bottom: 60px; }
.section-tag {
  display: inline-block; padding: 5px 16px; border-radius: 99px;
  background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.25);
  color: var(--purple); font-size: 0.75rem; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 16px;
}
.section-title { font-size: clamp(1.8rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 14px; }
.section-subtitle { color: var(--text-2); font-size: 1.05rem; max-width: 540px; margin: 0 auto; line-height: 1.7; }

/* ── DETECTOR SECTION ─────────────────────────────── */
.tab-switcher {
  display: flex; gap: 4px;
  background: rgba(255,255,255,0.03); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 6px;
  margin-bottom: 24px; overflow-x: auto;
}
.tab-btn {
  display: flex; align-items: center; gap: 8px;
  flex: 1; justify-content: center;
  padding: 12px 20px; border-radius: var(--radius-sm);
  background: transparent; border: none; cursor: pointer;
  color: var(--text-3); font-size: 0.9rem; font-weight: 600;
  transition: all 0.2s; white-space: nowrap; font-family: inherit;
}
.tab-btn:hover { color: var(--text-2); background: var(--surface); }
.tab-btn.active {
  background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(6,182,212,0.2));
  color: var(--text);
  border: 1px solid rgba(139,92,246,0.3);
  box-shadow: 0 4px 20px rgba(139,92,246,0.15);
}

.detector-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px;
  backdrop-filter: blur(10px);
  animation: fadeUp 0.4s ease;
}

.detector-layout {
  display: grid; grid-template-columns: 1fr 1fr; gap: 32px;
  min-height: 560px;
}

/* Input Column */
.detector-input-col { display: flex; flex-direction: column; gap: 16px; }
.input-header { display: flex; align-items: center; justify-content: space-between; }
.input-label { font-size: 0.85rem; font-weight: 600; color: var(--text-2); text-transform: uppercase; letter-spacing: 0.06em; }
.char-counter { font-size: 0.75rem; color: var(--text-3); font-family: 'JetBrains Mono', monospace; }

.text-area {
  flex: 1; min-height: 260px;
  background: rgba(255,255,255,0.03); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 16px;
  color: var(--text); font-size: 0.92rem; line-height: 1.7;
  font-family: 'Inter', sans-serif; resize: vertical;
  transition: border-color 0.2s, box-shadow 0.2s; outline: none;
}
.text-area:focus { border-color: rgba(139,92,246,0.5); box-shadow: 0 0 0 3px rgba(139,92,246,0.1); }
.text-area::placeholder { color: var(--text-3); }
.code-area { font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; }

.input-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
.input-hint { font-size: 0.78rem; color: var(--text-3); }
.input-actions { display: flex; gap: 8px; }

.sample-texts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.sample-label { font-size: 0.78rem; color: var(--text-3); }
.sample-chip {
  padding: 5px 12px; border-radius: var(--radius-xs);
  background: transparent; border: 1px solid var(--border-2);
  color: var(--text-2); font-size: 0.78rem; font-weight: 600; cursor: pointer;
  font-family: inherit; transition: all 0.2s;
}
.sample-chip:hover { border-color: var(--purple); color: var(--purple); background: rgba(139,92,246,0.08); }

.btn-analyze {
  width: 100%; padding: 16px; border-radius: var(--radius-sm);
  background: linear-gradient(135deg, var(--purple), var(--cyan));
  border: none; cursor: pointer; font-family: inherit; font-size: 1rem; font-weight: 700;
  color: #fff; display: flex; align-items: center; justify-content: center; gap: 10px;
  transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 4px 24px rgba(139,92,246,0.4); letter-spacing: 0.01em;
}
.btn-analyze:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 8px 32px rgba(139,92,246,0.5); }
.btn-analyze:active { transform: translateY(0); }
.btn-analyze:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

/* Lang select */
.lang-select {
  background: var(--surface); border: 1px solid var(--border);
  color: var(--text-2); font-size: 0.8rem; padding: 6px 10px;
  border-radius: var(--radius-xs); font-family: inherit; cursor: pointer; outline: none;
  transition: border-color 0.2s;
}
.lang-select:focus { border-color: var(--purple); }

/* Image drop zone */
.image-drop-zone {
  flex: 1; min-height: 220px;
  background: rgba(255,255,255,0.02); border: 2px dashed var(--border-2);
  border-radius: var(--radius-sm); cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  position: relative; overflow: hidden;
}
.image-drop-zone:hover, .image-drop-zone.dragover {
  border-color: var(--purple); background: rgba(139,92,246,0.05);
}
.drop-zone-inner {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
  color: var(--text-3); pointer-events: none;
}
.drop-icon { opacity: 0.5; }
.drop-title { font-size: 0.95rem; font-weight: 600; color: var(--text-2); }
.drop-sub { font-size: 0.8rem; }

.drop-preview { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.drop-preview img { max-width: 100%; max-height: 100%; object-fit: contain; padding: 8px; }
.remove-img {
  position: absolute; top: 8px; right: 8px;
  background: rgba(0,0,0,0.7); color: #fff; border: none; cursor: pointer;
  width: 28px; height: 28px; border-radius: 50%; font-size: 0.8rem;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s;
}
.remove-img:hover { background: var(--red); }

.image-url-row { display: flex; flex-direction: column; gap: 8px; }
.or-divider { text-align: center; font-size: 0.78rem; color: var(--text-3); }
.url-input-wrap { display: flex; gap: 8px; }
.url-input {
  flex: 1; background: rgba(255,255,255,0.03); border: 1px solid var(--border);
  color: var(--text); font-size: 0.85rem; padding: 8px 12px;
  border-radius: var(--radius-xs); font-family: inherit; outline: none;
  transition: border-color 0.2s;
}
.url-input:focus { border-color: rgba(139,92,246,0.5); }
.url-input::placeholder { color: var(--text-3); }

/* Result column */
.detector-result-col {
  display: flex; flex-direction: column;
  background: rgba(255,255,255,0.02); border: 1px solid var(--border);
  border-radius: var(--radius-sm); overflow: hidden; position: relative;
}

.result-placeholder {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 16px; color: var(--text-3); padding: 32px;
  text-align: center;
}
.placeholder-icon { opacity: 0.3; }
.result-placeholder p { font-size: 0.9rem; }

.result-panel {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 28px 24px; gap: 20px; overflow-y: auto;
}

/* Verdict badge */
.result-verdict {
  padding: 8px 24px; border-radius: 99px; font-size: 0.85rem; font-weight: 700;
  letter-spacing: 0.05em; text-transform: uppercase;
  border: 1px solid;
}
.verdict-ai    { background: rgba(239,68,68,0.12);   border-color: rgba(239,68,68,0.4);   color: var(--red);    }
.verdict-human { background: rgba(16,185,129,0.12);  border-color: rgba(16,185,129,0.4);  color: var(--green);  }
.verdict-mixed { background: rgba(245,158,11,0.12);  border-color: rgba(245,158,11,0.4);  color: var(--yellow); }

/* Score ring */
.result-score-ring-wrap { position: relative; display: inline-flex; }
.ring-center {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ring-score { font-size: 2rem; font-weight: 900; letter-spacing: -0.04em; }
.ring-label { font-size: 0.72rem; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.07em; }

/* Metrics grid */
.result-metrics {
  width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
}
.metric-item {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-xs); padding: 10px 12px;
}
.metric-name { font-size: 0.72rem; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px; }
.metric-bar { height: 4px; background: rgba(255,255,255,0.07); border-radius: 2px; overflow: hidden; margin-bottom: 4px; }
.metric-fill { height: 100%; border-radius: 2px; transition: width 1s cubic-bezier(0.4,0,0.2,1); }
.metric-val { font-size: 0.8rem; font-weight: 700; }

/* Breakdown */
.result-breakdown {
  width: 100%; background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-xs); padding: 14px 16px;
}
.breakdown-title { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-2); margin-bottom: 12px; }
.breakdown-item { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
.breakdown-item:last-child { margin-bottom: 0; }
.breakdown-row { display: flex; justify-content: space-between; align-items: center; }
.breakdown-label { font-size: 0.8rem; color: var(--text-2); }
.breakdown-score { font-size: 0.8rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; }
.breakdown-bar { height: 3px; background: rgba(255,255,255,0.06); border-radius: 2px; overflow: hidden; }
.breakdown-fill { height: 100%; border-radius: 2px; transition: width 1.2s cubic-bezier(0.4,0,0.2,1); }

.result-action-bar {
  width: 100%; display: flex; gap: 8px; justify-content: center; margin-top: auto;
}

/* ── HOW IT WORKS ─────────────────────────────────── */
.how-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
}
.how-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 28px 24px;
  position: relative; overflow: hidden;
  transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
  animation: fadeUp 0.5s both;
}
.how-card:hover {
  transform: translateY(-4px);
  border-color: rgba(139,92,246,0.4);
  box-shadow: 0 16px 40px rgba(139,92,246,0.15);
}
.how-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--purple), var(--cyan));
  opacity: 0; transition: opacity 0.3s;
}
.how-card:hover::before { opacity: 1; }

.how-num { font-size: 0.7rem; font-weight: 800; color: var(--purple); letter-spacing: 0.15em; margin-bottom: 16px; }
.how-icon {
  width: 52px; height: 52px; display: flex; align-items: center; justify-content: center;
  background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.2);
  border-radius: var(--radius-sm); margin-bottom: 18px;
  color: var(--purple);
}
.how-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 10px; }
.how-card p { font-size: 0.87rem; color: var(--text-2); line-height: 1.65; }

/* ── STATS ────────────────────────────────────────── */
.stats-section {
  background: linear-gradient(135deg, rgba(139,92,246,0.06), rgba(6,182,212,0.04));
  border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
}
.stats-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
  text-align: center; margin-bottom: 48px;
}
.stat-item { display: flex; flex-direction: column; gap: 6px; }
.stat-num {
  font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; letter-spacing: -0.05em;
  background: linear-gradient(135deg, var(--purple), var(--cyan));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  display: inline;
}
.stat-suffix { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; background: linear-gradient(135deg, var(--purple), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.stat-label { font-size: 0.85rem; color: var(--text-2); font-weight: 500; }

.stats-tagline { text-align: center; }
.stats-tagline p { color: var(--text-2); margin-bottom: 20px; font-size: 1.05rem; }
.trust-badges { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.trust-badge {
  padding: 8px 18px; border-radius: 99px;
  background: var(--surface); border: 1px solid var(--border);
  font-size: 0.82rem; font-weight: 600; color: var(--text-2);
}

/* ── FAQ ──────────────────────────────────────────── */
.faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
.faq-item {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-sm); overflow: hidden;
  transition: border-color 0.2s;
}
.faq-item:hover { border-color: rgba(139,92,246,0.3); }
.faq-q {
  width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 20px 24px; background: none; border: none; cursor: pointer; font-family: inherit;
  color: var(--text); font-size: 1rem; font-weight: 600; text-align: left;
}
.faq-chevron { flex-shrink: 0; transition: transform 0.3s; color: var(--text-3); }
.faq-q[aria-expanded="true"] .faq-chevron { transform: rotate(180deg); }
.faq-a { padding: 0 24px; max-height: 0; overflow: hidden; transition: max-height 0.3s ease, padding 0.3s ease; }
.faq-a:not([hidden]) { padding: 0 24px 20px; max-height: 300px; }
.faq-a p { color: var(--text-2); font-size: 0.9rem; line-height: 1.75; }

/* ── FOOTER ───────────────────────────────────────── */
.footer {
  border-top: 1px solid var(--border);
  background: rgba(0,0,0,0.3); backdrop-filter: blur(10px);
  position: relative; z-index: 1;
}
.footer-top {
  display: flex; justify-content: space-between; gap: 48px;
  padding: 56px 0 40px; flex-wrap: wrap;
}
.footer-brand { max-width: 260px; }
.footer-tagline { font-size: 0.85rem; color: var(--text-3); margin-top: 14px; line-height: 1.6; }
.footer-links { display: flex; gap: 48px; flex-wrap: wrap; }
.footer-col { display: flex; flex-direction: column; gap: 12px; }
.footer-col h4 { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-2); margin-bottom: 4px; }
.footer-col a { font-size: 0.87rem; color: var(--text-3); text-decoration: none; transition: color 0.2s; }
.footer-col a:hover { color: var(--text); }
.footer-bottom {
  border-top: 1px solid var(--border); padding: 20px 0;
  display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;
}
.footer-bottom p { font-size: 0.8rem; color: var(--text-3); }
.footer-badges { display: flex; gap: 16px; }
.footer-badges span { font-size: 0.8rem; color: var(--text-3); }

/* ── TOAST ────────────────────────────────────────── */
.toast-container {
  position: fixed; bottom: 24px; right: 24px; z-index: 999;
  display: flex; flex-direction: column; gap: 10px;
}
.toast {
  background: rgba(20,20,40,0.95); border: 1px solid var(--border-2);
  border-radius: var(--radius-sm); padding: 14px 18px;
  font-size: 0.88rem; color: var(--text); max-width: 320px;
  backdrop-filter: blur(12px); box-shadow: var(--shadow);
  animation: toastIn 0.3s ease;
  display: flex; align-items: center; gap: 10px;
}
.toast.success { border-color: rgba(16,185,129,0.5); }
.toast.error   { border-color: rgba(239,68,68,0.5); }
@keyframes toastIn {
  from { opacity: 0; transform: translateX(20px); }
  to   { opacity: 1; transform: translateX(0); }
}
@keyframes toastOut {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(20px); }
}

/* ── RESPONSIVE ───────────────────────────────────── */
@media (max-width: 900px) {
  .nav-links, .nav-cta { display: none; }
  .hamburger { display: flex; }
  .detector-layout { grid-template-columns: 1fr; }
  .how-grid { grid-template-columns: 1fr 1fr; }
  .stats-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .hero-actions { flex-direction: column; align-items: center; }
  .hero-stats { flex-direction: column; gap: 16px; padding: 20px; }
  .hstat-divider { width: 60px; height: 1px; }
  .how-grid { grid-template-columns: 1fr; }
  .stats-grid { grid-template-columns: 1fr 1fr; }
  .footer-top { flex-direction: column; }
  .footer-links { gap: 28px; }
  .detector-card { padding: 20px; }
  .tab-btn span { display: none; }
}
